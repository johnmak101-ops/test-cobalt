# Dependencies
node_modules
.pnpm-store
# pnpm workspace has ONE lockfile at the root — a per-package one means a stray standalone
# `pnpm install` ran inside a package, giving it a divergent dep copy (e.g. drizzle-orm),
# which breaks cross-package types. Never commit these.
packages/*/pnpm-lock.yaml

# Build outputs
dist
build
*.tsbuildinfo

# Database
*.sqlite
*.db

# Environment
.env
.env.local

# IDE
.vscode
.idea
*.swp
*.swo

# Local pave state (agent scratch/todos)
.pave/

# OS
.DS_Store
Thumbs.db

# Documents — client materials, real shipping emails, VM specs (confidential / bulky binaries)

# Logs
pave.log
.run-*.log

# Local Claude tooling (preview launch config, etc.)
/.claude/

# runtime logs / scratch
backend/_run.*.log
backend/logs/
tmp/

# dev server logs
frontend/_vite.*.log
.gstack/

# agent scratch: subagent-driven-development task reports (process artifacts, not product docs)
.superpowers/

# local git worktrees used for branch isolation
.worktrees/

# Doctor health configs ARE product (gate scores ≥90). Do not gitignore them —
# they encode intentional rule ignores (global APP_GUARD, module boundaries, etc.).
# JSON doctor dumps stay local:
_be-doctor*.json
_fe-doctor*.json
_fe-verbose.txt

# Agent / loop scratch — never commit (local only)
.pr-body*.md
LOOP.md
loop-budget.md
loop-constraints.md
loop-run-log.md
july-hardening-state.md
doctor-sweeper-state.md
gate.yaml
tmp-*.ts
tmp-*.js
tmp-*.mjs
backend/_boot*.log
backend/_q*.js
backend/_dismiss*.js
backend/_patch*.js
_dev.log

# Client bulk / confidential (not product docs)
/docs/Emails/
/docs/Materials from client/
/docs/sample shiptrack emails/
/docs/VM Spec/
/docs/track-system-build-plan.md
/docs/designs/
/docs/diagrams/*mockup*
/docs/diagrams/*.png
/docs/diagrams/*.drawio*

# backend dev scratch: ad-hoc probes / one-off ops scripts (clean-start.ts IS tracked —
# cobalt-queue src/dev/clean-start.ts documents it as the paired reset)
backend/src/dev/_*
backend/_q*

# Runtime output, not source: human multi-candidate picks appended daily by
# review/ambiguity-pick-log.ts (AMBIGUITY_PICK_DIR, default backend/data/ambiguity).
# Machine-local telemetry — each dev's file differs, and committing them would collide.
backend/data/
