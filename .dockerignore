# deps + build outputs (rebuilt inside the image)
**/node_modules
**/dist
**/.vite
**/coverage

# the packages/contracts nested "shadow store" — must NOT leak in (997-phantom-tsc trap);
# the ROOT workspace manages contracts' deps in the image
packages/contracts/pnpm-lock.yaml
packages/contracts/pnpm-workspace.yaml

# local env (the container gets DATABASE_URL etc. from compose, not a baked .env)
**/.env
**/.env.*

# vcs / editor / scratch
.git
.gitignore
.claude
**/*.log
scratch
DEMO-SCRIPT.md

# docker meta
Dockerfile
docker-compose.yml
.dockerignore
