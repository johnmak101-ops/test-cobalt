# Backend environment. Copy to `.env` and fill the blanks. NEVER commit `.env`.
# Docker Compose also reads a **repo-root** `.env` for ${VAR} substitution — see `../.env.example`.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# Auth: random string ≥32 chars
JWT_SECRET=

# SQL Server / Fabric SQL (ADO.NET-style; local dev = mssql container)
SQL_SERVER_URL=Server=localhost,1433;Database=cobalt;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=false;TrustServerCertificate=true
# Fabric SQL (Entra Service Principal) — no secret in git:
#   SQL_SERVER_URL=Server=<endpoint>.database.fabric.microsoft.com,1433;Database=<db>;Authentication=Active Directory Service Principal;User Id=<client-id>;Password=<client-secret>;Tenant Id=<tenant-id>;Encrypt=true
# With Authentication=…, db:migrate SKIPS CREATE DATABASE (Fabric DB is pre-provisioned).

PORT=3000
# NODE_ENV=production
# STATIC_ROOT=                 # set by Docker image to serve SPA; leave unset in local Vite+API dev
# CORS_ORIGINS=
# SESSION_TTL_HOURS=

# ---------------------------------------------------------------------------
# Background jobs — the four things that run on a timer and WRITE to the database.
#
# All four are ON by default with the values below; set a var to 0 to disable that
# job (its manual/CLI trigger still works). Nothing here is required — the defaults
# are the intended production settings unless a line says otherwise.
#
#   Job                 Variable                     Default   Writes to
#   ------------------- ---------------------------- --------- ---------------------
#   Alert evaluator     ALERT_EVAL_INTERVAL_MS       15 min    alerts
#   Lifecycle refresh   STATE_REFRESH_INTERVAL_MS    1 hour    shipments.state
#   Mesh masters sync   MESH_SYNC_INTERVAL_MS        24 h      customers/vendors/forwarders
#   Ports CSV sync      PORTS_SYNC_INTERVAL_MS       ~30 d     ports
#
# The last two have their own sections further down (they need credentials / URLs).
# ---------------------------------------------------------------------------

# Fires + auto-resolves the A1/A3 threshold alerts. Reads the clock, so alerts appear
# without any new email arriving. First run 15s after boot. 0 = off.
# Manual trigger: POST /api/alerts/evaluate
ALERT_EVAL_INTERVAL_MS=900000

# Re-derives each live leg's lifecycle state from its own dates + recorded email types.
# Exists because deriveState is otherwise only called when an email is committed, so a
# shipment that goes quiet freezes at whatever its last email could prove. Promote-only:
# a leg is never walked backwards. First run 30s after boot. 0 = off.
# Manual trigger: POST /api/reconcile/refresh-state   (add ?dryRun=1 to report, not write)
#
# ⚠ FIRST DEPLOY TO AN EXISTING DATABASE: set this to 0, run the dry-run, read the
#   `promotions` list, then remove the override. On a database that has never had this
#   run, the first tick promotes every leg whose dates have quietly come true — correct,
#   but a one-off bulk move that looks alarming if nobody expected it.
STATE_REFRESH_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Seed (`pnpm --filter backend seed` / Docker entrypoint when SEED_ON_START=1)
# ---------------------------------------------------------------------------
# ALWAYS (SEED_DEMO unset or 0): curated ports + alert_rules A1–A4 + app_settings + users.
#   Users: super@cobalt.hk, admin@cobalt.hk (mustReset), agent@cobalt.hk (queue matcher).
#   Does NOT insert email_message or parsed_record.
#
# SEED_DEMO=1 only: also demo masters, fixture booking/legs, review-queue mock emails.
#   Leave UNSET or 0 in Docker/prod. Emails come from cobalt-queue ingest, not seed.
SEED_DEMO=0

# Human admin first-login password (mustReset=true). Dev default if unset: cobalt-change-me
# SEED_INITIAL_PASSWORD=cobalt-change-me
# Agent VM service account (must match queue TRACKING_AGENT_PASSWORD). Dev default: cobalt
# TRACKING_AGENT_PASSWORD=cobalt

# Docker entrypoint only (compose defaults):
# RUN_MIGRATIONS=1
# SEED_ON_START=1

# ---------------------------------------------------------------------------
# Cobalt Mesh masters pull (customers / vendors / forwarders)
# Nest MastersSyncSchedulerService — NOT part of seed.
# Values from Master_Data_API.md (confidential). Required for scheduled sync.
# ---------------------------------------------------------------------------
MESH_BASE_URL=https://operationapps.cobaltknitwear.com/cobaltmesh/api
MESH_TENANT_ID=
MESH_CLIENT_ID=
MESH_CLIENT_SECRET=
MESH_SCOPE=api://<resource-app-id>/.default
# Schedule: default 86400000 (24h). 0 = Nest schedule off (CLI `pnpm --filter backend` sync still works).
MESH_SYNC_INTERVAL_MS=86400000
# Boot pull: omit = only if last success older than ~23h; 0=never on boot; 1=always on boot.
#MESH_SYNC_ON_BOOT=

# ---------------------------------------------------------------------------
# Ports CSV master pull (UN/LOCODE + OurAirports — free public CSVs, no Mesh)
# Nest PortsSyncSchedulerService — NOT part of seed.
# ---------------------------------------------------------------------------
# Schedule: default ~30d (2592000000 ms). 0 = off (CLI `pnpm --filter backend ports:sync` still works).
# ⚠ Pulls from raw.githubusercontent.com and davidmegginson.github.io. On an intranet host with
#   no outbound internet this is a monthly failed fetch and a log error for no benefit — set 0
#   there and run the CLI from a machine with egress when the port list actually needs refreshing.
PORTS_SYNC_INTERVAL_MS=2592000000
# Boot: omit = only if last success older than ~28d; 0=never; 1=always.
#PORTS_SYNC_ON_BOOT=
#PORTS_UNLOCODE_URL=https://raw.githubusercontent.com/datasets/un-locode/master/data/code-list.csv
#PORTS_OURAIRPORTS_URL=https://davidmegginson.github.io/ourairports-data/airports.csv
#PORTS_CACHE_DIR=./data/ports-cache

# ---------------------------------------------------------------------------
# Microsoft Graph (optional — attachment re-fetch when matcher did not forward bytes)
# ---------------------------------------------------------------------------
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=
#GRAPH_MAILBOX=

# ---------------------------------------------------------------------------
# cobalt-queue learning feed (human corrections → Iterator TRAIN)
# Unset QUEUE_API_BASE to run ShipTrack standalone (no push).
# ---------------------------------------------------------------------------
#QUEUE_API_BASE=http://127.0.0.1:3100/api
#QUEUE_API_PASSWORD=          # same as queue VIEWER_PASSWORD (or ADMIN_PASSWORD)
#QUEUE_VIEWER_PASSWORD=       # alias for QUEUE_API_PASSWORD

# ---------------------------------------------------------------------------
# Logging & diagnostics — all optional, listed so nothing the code reads is invisible.
# ---------------------------------------------------------------------------
#LOG_LEVEL=info               # pino level. Default: info
#LOG_FILE=logs/backend        # rotating file prefix. Default: logs/backend
#MASTER_MAPS_TTL_MS=30000     # in-memory master lookup cache. Default: 30000 (30s)
# Dev only — dumps matcher ambiguity picks for offline review. Off unless a path is set.
#AMBIGUITY_PICK_DIR=
#AMBIGUITY_PICK_JSONL=0       # set 0/false to suppress the JSONL sidecar
