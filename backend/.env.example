# Backend environment. Copy to `.env` and fill the blanks. NEVER commit `.env`.

# Auth (required): a random string ≥32 chars
JWT_SECRET=

# SQL Server / Fabric SQL (ADO.NET-style connection string; local dev = the mssql-2022 container)
SQL_SERVER_URL=Server=localhost,1433;Database=cobalt;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=false;TrustServerCertificate=true
# For Microsoft Fabric SQL (Entra Service Principal auth) use instead — no secret in git:
#   SQL_SERVER_URL=Server=<endpoint>.database.fabric.microsoft.com,1433;Database=<db>;Authentication=Active Directory Service Principal;User Id=<client-id>;Password=<client-secret>;Tenant Id=<tenant-id>;Encrypt=true
# The `Authentication` keyword selects Entra SP (encryption is forced on), and db:migrate then SKIPS
# CREATE DATABASE — the Fabric database is pre-provisioned and `master` is not exposed to the principal.

# Cobalt Mesh master-data API — used by the daily masters sync (src/db/sync-masters.ts).
# Values come from "Master_Data_API.md" (confidential). The base URL has a code default; the rest are required.
MESH_BASE_URL=https://operationapps.cobaltknitwear.com/cobaltmesh/api
MESH_TENANT_ID=
MESH_CLIENT_ID=
MESH_CLIENT_SECRET=
MESH_SCOPE=api://<resource-app-id>/.default
# Nest in-app Mesh masters sync (shiptrack#161). Default 86400000 (24h). 0 = off (CLI cron still works).
#MESH_SYNC_INTERVAL_MS=86400000
# Boot pull: omit = only if last success older than ~23h; 0=never on boot; 1=always on boot.
#MESH_SYNC_ON_BOOT=

# Seed the local demo dataset (customers/vendors/forwarders + demo shipments + review queue).
# Leave UNSET in prod — the seed then loads only ports + admin config, and masters come from the Mesh sync.
SEED_DEMO=1

# cobalt-queue learning feed (human corrections + confirm-sentinels → Iterator TRAIN signal).
# Unset QUEUE_API_BASE to run ShipTrack standalone (no push).
# When the queue has VIEWER_PASSWORD set, every POST needs a Bearer JWT from POST {QUEUE_API}/login.
# #116: without QUEUE_API_PASSWORD, corrections 401 and were previously only log.warn'd (silent TRAIN loss).
#QUEUE_API_BASE=http://127.0.0.1:3100/api
#QUEUE_API_PASSWORD=          # same as queue VIEWER_PASSWORD (or ADMIN_PASSWORD)
#QUEUE_VIEWER_PASSWORD=       # alias for QUEUE_API_PASSWORD
