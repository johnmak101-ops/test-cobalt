# Backend environment. Copy to `.env` and fill the blanks. NEVER commit `.env`.

# Auth (required): a random string ≥32 chars
JWT_SECRET=

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cobalt

# Cobalt Mesh master-data API — used by the daily masters sync (src/db/sync-masters.ts).
# Values come from "Master_Data_API.md" (confidential). The base URL has a code default; the rest are required.
MESH_BASE_URL=https://operationapps.cobaltknitwear.com/cobaltmesh/api
MESH_TENANT_ID=
MESH_CLIENT_ID=
MESH_CLIENT_SECRET=
MESH_SCOPE=api://<resource-app-id>/.default

# Seed the local demo dataset (customers/vendors/forwarders + demo shipments + review queue).
# Leave UNSET in prod — the seed then loads only ports + admin config, and masters come from the Mesh sync.
SEED_DEMO=1
