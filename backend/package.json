{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -P tsconfig.json src/db/seed.ts",
    "seed:prod": "node dist/db/seed.js",
    "ports:sync": "ts-node -P tsconfig.json src/db/sync-ports.ts",
    "ports:sync:prod": "node dist/db/sync-ports.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "doctor": "nestjs-doctor .",
    "smoke": "node test/smoke.mjs",
    "db:migrate": "ts-node -P tsconfig.json src/db/migrate-cli.ts",
    "db:migrate:prod": "node dist/db/migrate-cli.js",
    "db:codegen": "kysely-codegen --dialect mssql --url \"Server=localhost,1433;Database=cobalt_test;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=false;TrustServerCertificate=true\" --out-file src/db/kysely/db.generated.ts --camel-case --exclude-pattern \"kysely_*\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.2.0",
    "kysely": "^0.29.3",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@swc/core": "^1.15.43",
    "@tediousjs/connection-string": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "kysely-codegen": "^0.20.0",
    "nestjs-doctor": "^0.5.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.8"
  }
}
