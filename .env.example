# Repo-root env for **Docker Compose** variable substitution (${VAR} in docker-compose.yml).
# Copy to `.env` next to docker-compose.yml. NEVER commit `.env`.
#
# Local Nest/Vite dev can use backend/.env instead (see backend/.env.example).

# ---------------------------------------------------------------------------
# Compose / image
# ---------------------------------------------------------------------------
# Defaults to the local tag `shiptrack:latest`. Set this only when publishing to or pulling from
# a registry — e.g. SHIPTRACK_IMAGE=<registry>/<org>/cobalt-shiptrack:latest
# SHIPTRACK_IMAGE=
# APP_PORT=3000
# DB_PORT=1433
JWT_SECRET=cobalt-demo-jwt-secret-change-in-production-0123456789

# ---------------------------------------------------------------------------
# Boot: migrations + seed (entrypoint)
# ---------------------------------------------------------------------------
RUN_MIGRATIONS=1
SEED_ON_START=1
# Prod-shape seed only (ports + users + alert rules). Do NOT set to 1 in Docker.
SEED_DEMO=0
SEED_INITIAL_PASSWORD=cobalt-change-me
TRACKING_AGENT_PASSWORD=cobalt

# ---------------------------------------------------------------------------
# Cobalt Mesh masters pull (required for daily customer/vendor/forwarder sync)
# From Master_Data_API.md — leave blank and Mesh schedule logs off.
# ---------------------------------------------------------------------------
MESH_BASE_URL=https://operationapps.cobaltknitwear.com/cobaltmesh/api
MESH_TENANT_ID=
MESH_CLIENT_ID=
MESH_CLIENT_SECRET=
MESH_SCOPE=api://<resource-app-id>/.default
MESH_SYNC_INTERVAL_MS=86400000

# ---------------------------------------------------------------------------
# Ports CSV master pull (UN/LOCODE + OurAirports). Default ~30 days; 0 = off.
# ---------------------------------------------------------------------------
PORTS_SYNC_INTERVAL_MS=2592000000
